# ============================================================================
# ResearchPaper AI — environment configuration
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# ============================================================================

# --- Application -----------------------------------------------------------
APP_NAME=ResearchPaper AI
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# --- Server ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed origins, or "*" for all (dev only).
CORS_ORIGINS=*

# --- Google Gemini ------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Optional: leave blank to use local keyword search and extractive answers.
# Add your key here only in your private .env file or hosting provider settings.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_REQUEST_TIMEOUT=60
GEMINI_MAX_OUTPUT_TOKENS=2048
MAX_OCR_PAGES=30

# --- RAG pipeline --------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
MAX_UPLOAD_MB=25

# --- Storage -------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store
DATABASE_URL=sqlite:///./data/app.db
LOG_DIR=./logs
LOG_LEVEL=INFO
